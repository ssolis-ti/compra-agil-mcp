{
  "name": "@ssolis-ti/mcp-compra-agil",
  "version": "2.8.0",
  "description": "Servidor MCP para la API Compra Ágil v2 de Mercado Público (Chile)",
  "type": "module",
  "bin": {
    "mcp-compra-agil": "dist/index.js"
  },
  "files": [
    "dist",
    "docs/api",
    "docs/guias",
    "docs/README.md"
  ],
  "author": "ssolis-ti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssolis-ti/compra-agil-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ssolis-ti/compra-agil-mcp/issues"
  },
  "homepage": "https://github.com/ssolis-ti/compra-agil-mcp#readme",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "monitor": "node dist/services/monitor.js",
    "test": "vitest run",
    "lint": "eslint",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm run build && npm run test:coverage",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "nodemailer": "^10.0.16",
    "pdf-parse": "^2.4.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "compra-agil",
    "mercado-publico",
    "chile",
    "gobierno",
    "licitaciones"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.16.0 <21 || >=22.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
