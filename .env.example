# ─── Credencial ────────────────────────────────────────────────────────
#
# Ticket de acceso a la API de Compra Ágil de Mercado Público
# Solicitar credenciales en: https://www.chilecompra.cl/api/ (requiere Clave Única)
#
# MANEJO SEGURO:
#  - Guarda el ticket SOLO en este archivo .env (ya está en .gitignore).
#  - NO lo pegues en el chat, ni en issues, ni en capturas de pantalla.
#  - NO lo pases inline en la terminal (COMPRA_AGIL_TICKET=xxx node ...):
#    queda en el historial del shell y visible en la lista de procesos.
#  - Para comprobar que funciona, usa la herramienta `verificar_ticket`:
#    valida contra la API sin revelar el valor (solo muestra ••••1234).
#  - El servidor redacta el ticket de todo log, error y respuesta (utils/redact.ts),
#    pero esa es la última línea de defensa, no un permiso para exponerlo.
COMPRA_AGIL_TICKET=tu_ticket_de_acceso_aqui

# URL base oficial de la API Compra Ágil v2
COMPRA_AGIL_BASE_URL=https://api2.mercadopublico.cl

# Corte de cada consulta a la API, en milisegundos (por defecto 35000).
# La pasarela de Mercado Público responde 504 a los ~30 s; este límite corta
# solo lo que la pasarela no cortó. Bajarlo de 30000 cancela consultas legítimas.
# COMPRA_AGIL_TIMEOUT_MS=35000

# Tiempo máximo de cada llamada a una herramienta, en ms (por defecto 45000),
# bajo el corte de ~60 s de los clientes MCP. Si una consulta tendría que
# esperar más en el límite propio de 15 consultas/min, no se envía (no gasta
# cuota) y la herramienta responde con lo que tenga, diciendo qué omitió.
# COMPRA_AGIL_PRESUPUESTO_MS=45000

# Carpeta de datos (caché, estado de cuota, estado del daemon e informes).
# Por defecto: esta carpeta del proyecto si es un clon del repositorio; si el
# servidor se instaló con npx, %LOCALAPPDATA%\mcp-compra-agil en Windows o
# ~/.local/state/mcp-compra-agil en el resto. No depende de la carpeta desde
# la que el cliente MCP lanza el servidor.
# COMPRA_AGIL_DATA_DIR=

# Carpeta raíz de los informes de `generar_informe` (por defecto <carpeta de datos>/informes).
# El parámetro ruta_salida solo acepta subcarpetas dentro de ella.
# COMPRA_AGIL_INFORMES_DIR=./informes

# ─── Vigilancia (daemon: npm run monitor) ───────────────────────────────
# Lee la API lote por lote (cada 5 min) sin huecos: el intervalo solo cambia
# cuánto tarda el aviso, no cuánta cuota gasta (~470 consultas al día).

# Minutos entre rondas (por defecto 15)
MONITOR_INTERVAL_MINUTES=15

# Presupuesto mínimo en CLP para alertar. 0 = sin mínimo (por defecto).
# Ojo: con 5000000 se pierde ~84 % de los procesos (mediana medida: $800.000).
MONITOR_MIN_BUDGET_CLP=0

# Palabras clave de interés en el título (separadas por coma). Vacío = cualquiera.
MONITOR_KEYWORDS=software, desarrollo, licencias, plataforma, sistema, soporte, cloud

# Palabras que descartan un proceso aunque calce una palabra clave
# MONITOR_EXCLUIR=toner, arriendo

# Regiones (códigos 1-16, separados por coma). Vacío = todas.
# MONITOR_REGIONES=13,5

# Alertar solo procesos sin ofertas (por defecto true)
# MONITOR_SOLO_SIN_OFERTAS=true

# ─── Avisos (2.9.0) ─────────────────────────────────────────────────────
# Canales activos, separados por coma: telegram (webhook y correo, próximamente).
# Los destinos solo se configuran aquí: ninguna herramienta MCP puede cambiarlos.
# COMPRA_AGIL_AVISOS=telegram

# Telegram: crea un bot con @BotFather y pega aquí su token. Luego escríbele algo
# al bot y corre `npx mcp-compra-agil --telegram-chat-id` para obtener el chat id.
# COMPRA_AGIL_TELEGRAM_TOKEN=
# COMPRA_AGIL_TELEGRAM_CHAT_ID=

# Horario de silencio (hora de Chile): lo de la noche llega en un resumen al terminar.
# COMPRA_AGIL_AVISOS_SILENCIO=22:00-07:00
